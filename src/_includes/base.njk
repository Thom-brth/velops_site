{#- Gabarit commun à toutes les pages. Variables de page (front matter) : title, description, nav (URL du menu actif). -#}
{%- set tel = site.telephone | telHref -%}
{%- set menu = [
  ["/", "Accueil"],
  ["/prestations-tarifs/", "Prestations & tarifs"],
  ["/velos-a-vendre/", "Vélos à vendre"] if site.SHOW_BIKES,
  ["/comment-ca-marche/", "Comment ça marche"],
  ["/a-propos/", "À propos"],
  ["/faq/", "FAQ"],
  ["/contact/", "Contact"]
] | select -%}
<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title }}{% if page.url != "/" %} · {{ site.nom }}{% endif %}</title>
  <meta name="description" content="{{ description or site.description }}">
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  <meta property="og:type" content="website">
  <meta property="og:locale" content="fr_FR">
  <meta property="og:site_name" content="{{ site.nom }}">
  <meta property="og:title" content="{{ title }}">
  <meta property="og:description" content="{{ description or site.description }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:image" content="{{ site.url }}/assets/og.png">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta name="theme-color" content="#1d4a3a">
  <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/assets/style.css">
  <script>document.documentElement.classList.add("js")</script>
  <script type="application/ld+json">{{ site | jsonLd(tarifs) | safe }}</script>
  {%- if site.goatcounter %}
  <script data-goatcounter="https://{{ site.goatcounter }}.goatcounter.com/count" async src="https://gc.zgo.at/count.js"></script>
  {%- endif %}
</head>
<body>
  <a class="skip" href="#contenu">Aller au contenu</a>
  <header class="site-header">
    <div class="wrap header-inner">
      <a class="logo" href="/" aria-label="{{ site.nom }}, accueil">
        <svg viewBox="0 0 32 32" width="32" height="32" aria-hidden="true"><circle cx="16" cy="16" r="13" fill="none" stroke="currentColor" stroke-width="3"/><circle cx="16" cy="16" r="3" fill="currentColor"/><path d="M16 3v26M3 16h26M6.8 6.8l18.4 18.4M25.2 6.8 6.8 25.2" stroke="currentColor" stroke-width="1.4"/></svg>
        <span>Brignais <b>Cycle</b></span>
      </a>
      <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="nav">Menu</button>
      <nav id="nav" class="nav" aria-label="Menu principal">
        <ul>
          {%- for item in menu %}
          <li><a href="{{ item[0] }}"{% if page.url == item[0] %} aria-current="page"{% endif %}>{{ item[1] }}</a></li>
          {%- endfor %}
        </ul>
      </nav>
    </div>
  </header>

  <main id="contenu">
    {{ content | safe }}
  </main>

  <footer class="site-footer">
    <div class="wrap footer-grid">
      <div>
        <p class="footer-title">{{ site.nom }}</p>
        <p>Atelier vélo sur rendez-vous<br>{{ site.lieu_public }}</p>
        <p><a href="tel:{{ tel }}">{{ site.telephone }}</a><br><a href="mailto:{{ site.email }}">{{ site.email }}</a></p>
      </div>
      <div>
        <p class="footer-title">Créneaux</p>
        <ul class="plain">
          {%- for c in site.creneaux %}
          <li>{{ c.jours }} : {{ c.horaires }}{% if c.note %}, {{ c.note }}{% endif %}</li>
          {%- endfor %}
        </ul>
      </div>
      <div>
        <p class="footer-title">Infos</p>
        <ul class="plain">
          <li><a href="/mentions-legales/">Mentions légales</a></li>
          <li><a href="/cgv/">CGV atelier</a></li>
          <li><a href="/confidentialite/">Confidentialité</a> (aucun cookie)</li>
        </ul>
      </div>
    </div>
  </footer>

  <div class="callbar" aria-label="Prendre rendez-vous">
    <a class="btn btn-cta" href="tel:{{ tel }}">Appeler</a>
    <a class="btn btn-cta-alt" href="sms:{{ tel }}">SMS</a>
  </div>

  <script>
    // Menu mobile : sans JS, le menu reste simplement affiché en entier.
    const b = document.querySelector(".nav-toggle"), n = document.getElementById("nav");
    b.addEventListener("click", () => {
      const open = b.getAttribute("aria-expanded") !== "true";
      b.setAttribute("aria-expanded", open);
      n.classList.toggle("open", open);
    });
  </script>
  {%- if scripts %}{% for s in scripts %}
  <script src="{{ s }}" defer></script>
  {%- endfor %}{% endif %}
</body>
</html>
