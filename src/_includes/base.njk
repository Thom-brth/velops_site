{#- Gabarit commun. Front matter des pages : title (titre affiché), titre_seo (balise <title>, optionnel), description,
    et pour l'en-tête intérieur : surtitre, chapo (voir page-tete.njk). -#}
{%- from "icones.njk" import fleche, logo -%}
{%- set tel = site.telephone | telHref -%}
{%- set sms = site | smsHref -%}
{%- set menu = [
  ["/", "Accueil"],
  ["/prestations-tarifs/", "Prestations & tarifs"],
  ["/velos-a-vendre/", "Vélos à vendre"] if site.SHOW_BIKES,
  ["/comment-ca-marche/", "Comment ça marche"],
  ["/a-propos/", "À propos"],
  ["/faq/", "FAQ"],
  ["/contact/", "Contact"]
] | select -%}
<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>{{ titre_seo or title }}{% if page.url != "/" %} · {{ site.nom }}{% endif %}</title>
  <meta name="description" content="{{ description or site.description }}">
  <meta property="og:type" content="website">
  <meta property="og:locale" content="fr_FR">
  <meta property="og:site_name" content="{{ site.nom }}">
  <meta property="og:title" content="{{ title }}{% if page.url != "/" %} · {{ site.nom }}{% endif %}">
  <meta property="og:description" content="{{ description or site.description }}">
  {%- if not (site.url | isTodo) %}
  {#- Adresses absolues : émises seulement quand data/site.json > url est renseignée. #}
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:image" content="{{ site.url }}/assets/og.png">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  {%- endif %}
  <meta name="theme-color" content="#141518">
  <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/assets/apple-touch-icon.png">
  <link rel="preload" href="/assets/fonts/archivo.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/assets/style.css">
  <script>document.documentElement.classList.add("js")</script>
  <script type="application/ld+json">{{ site | jsonLd(tarifs) | safe }}</script>
  {%- if site.goatcounter %}
  <script data-goatcounter="https://{{ site.goatcounter }}.goatcounter.com/count" async src="https://gc.zgo.at/count.js"></script>
  {%- endif %}
</head>
<body>
  <a class="skip" href="#contenu">Aller au contenu</a>
  <header class="entete">
    <div class="wrap entete-in">
      <a class="logo" href="/" aria-label="{{ site.nom }}, accueil">
        {{ logo() }}
        <span class="logo-txt" aria-hidden="true">Brignais<span>Cycle</span></span>
      </a>
      <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="nav"><span class="nav-toggle-barres" aria-hidden="true"></span><span class="nav-toggle-txt">Menu</span></button>
      <nav id="nav" class="nav" aria-label="Menu principal">
        <ul>
          {%- for item in menu %}
          <li><a href="{{ item[0] }}"{% if page.url == item[0] %} aria-current="page"{% endif %}>{{ item[1] }}</a></li>
          {%- endfor %}
        </ul>
        <div class="nav-rdv">
          <p class="label">Sur rendez-vous · {{ site.ville }} ({{ site.code_postal }})</p>
          <a class="btn btn-signal" href="tel:{{ tel }}">Appeler {{ fleche() }}</a>
          <a class="btn btn-ligne" href="{{ sms }}">Envoyer un SMS</a>
        </div>
      </nav>
      <a class="btn btn-signal entete-cta" href="tel:{{ tel }}">{% if site.telephone | isTodo %}Appeler{% else %}{{ site.telephone }}{% endif %} {{ fleche() }}</a>
    </div>
  </header>

  <main id="contenu">
    {{ content | safe }}
  </main>

  <footer class="pied">
    <div class="wrap pied-grid">
      <div>
        <p class="label">L'atelier</p>
        <p>Réparation et entretien vélo, uniquement sur rendez-vous.<br>{{ site.ville }} ({{ site.code_postal }}).</p>
        <p><a href="tel:{{ tel }}">{{ site.telephone }}</a><br><a href="mailto:{{ site.email }}">{{ site.email }}</a></p>
      </div>
      <div>
        <p class="label">Créneaux</p>
        <ul>
          {%- for c in site.creneaux %}
          <li>{{ c.jours }} : {{ c.horaires }}{% if c.note %}, {{ c.note }}{% endif %}</li>
          {%- endfor %}
        </ul>
      </div>
      <div>
        <p class="label">Pages</p>
        <ul>
          {%- for item in menu %}
          <li><a href="{{ item[0] }}">{{ item[1] }}</a></li>
          {%- endfor %}
        </ul>
      </div>
      <div>
        <p class="label">Infos</p>
        <ul>
          <li><a href="/mentions-legales/">Mentions légales</a></li>
          <li><a href="/cgv/">CGV atelier</a></li>
          <li><a href="/confidentialite/">Confidentialité</a></li>
          <li>Aucun cookie, aucun traceur</li>
        </ul>
      </div>
    </div>
    <div class="wrap">
      <p class="pied-marque" aria-hidden="true">Brignais Cycle</p>
      <div class="pied-bas">
        <p class="label">© {{ "now" | annee }} {{ site.exploitant }} EI · TVA non applicable, art. 293 B du CGI</p>
        <p class="label">Brignais (69530) et alentours</p>
      </div>
    </div>
  </footer>

  <div class="barre-appel">
    <a class="btn btn-signal" href="tel:{{ tel }}">Appeler</a>
    <a class="btn btn-ligne" href="{{ sms }}">SMS</a>
  </div>

  <script>
    // Menu mobile plein écran. Sans JS, le menu reste affiché sous le logo.
    {
      const b = document.querySelector(".nav-toggle"), n = document.getElementById("nav"), t = b.querySelector(".nav-toggle-txt");
      const fond = document.querySelectorAll("main, footer, .barre-appel");
      const ouvrir = (o) => {
        b.setAttribute("aria-expanded", o);
        n.classList.toggle("open", o);
        document.documentElement.classList.toggle("menu-ouvert", o);
        fond.forEach((el) => (el.inert = o)); // Tab reste dans le menu ouvert
        t.textContent = o ? "Fermer" : "Menu";
      };
      b.addEventListener("click", () => ouvrir(b.getAttribute("aria-expanded") !== "true"));
      document.addEventListener("keydown", (e) => { if (e.key === "Escape" && n.classList.contains("open")) { ouvrir(false); b.focus(); } });
      addEventListener("pageshow", (e) => e.persisted && ouvrir(false)); // retour arrière Safari (cache)
      const large = matchMedia("(min-width: 1120px)");
      large.addEventListener ? large.addEventListener("change", () => ouvrir(false)) : large.addListener(() => ouvrir(false));
    }
  </script>
  {%- if scripts %}{% for s in scripts %}
  <script src="{{ s }}" defer></script>
  {%- endfor %}{% endif %}
</body>
</html>
