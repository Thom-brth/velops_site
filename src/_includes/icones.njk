{#- Icônes en ligne (décoratives : aria-hidden). Usage : {% from "icones.njk" import fleche, externe %} puis {{ fleche() }}. -#}
{% macro fleche() %}<svg class="ico" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M1.5 8h12M9 3.5 13.5 8 9 12.5" fill="none" stroke="currentColor" stroke-width="1.8"/></svg>{% endmacro %}
{% macro externe() %}<svg class="ico" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M4 12 12 4M5.5 4H12v6.5" fill="none" stroke="currentColor" stroke-width="1.8"/></svg>{% endmacro %}
{% macro logo() %}<svg class="logo-mark" viewBox="-20 -20 40 40" aria-hidden="true" focusable="false"><g fill="none" stroke="currentColor"><circle r="16" stroke-width="4.2" stroke-dasharray="2.6 2.43"/><circle r="9.5" stroke-width="1.6"/><path stroke-width="2.6" stroke-linecap="round" d="M0-3.5V-9M3.3-1.1 8.6-2.8M2 2.8 5.3 7.3M-2 2.8-5.3 7.3M-3.3-1.1-8.6-2.8"/></g><circle r="2.6" fill="var(--signal)"/></svg>{% endmacro %}
